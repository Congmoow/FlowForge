<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FlowForge.App.App"
             RequestedThemeVariant="Default">
             <!-- Default 会跟随系统主题，也可改为 Dark 或 Light。 -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
