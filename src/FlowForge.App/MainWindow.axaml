<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FlowForge.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="760"
        x:Class="FlowForge.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding ApplicationName}"
        Width="1200"
        Height="760"
        MinWidth="960"
        MinHeight="600">
    <Grid ColumnDefinitions="240,*,300"
          RowDefinitions="Auto,*"
          Background="#F6F7F9">
        <Border Grid.ColumnSpan="3"
                Background="#FFFFFF"
                BorderBrush="#D8DEE8"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <TextBlock Text="{Binding ApplicationName}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#172033" />
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                Background="#FFFFFF"
                BorderBrush="#D8DEE8"
                BorderThickness="0,0,1,0"
                Padding="16">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding ToolboxTitle}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#243044"
                           Margin="0,0,0,12" />
                <TextBlock Text="内置节点会在后续阶段加入。"
                           TextWrapping="Wrap"
                           Foreground="#667085" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="18"
                Background="#FFFFFF"
                BorderBrush="#D8DEE8"
                BorderThickness="1"
                Padding="18">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding CanvasTitle}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#243044"
                           Margin="0,0,0,12" />
                <Border Background="#F0F3F7"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1">
                    <TextBlock Text="画布将在下一项渲染静态节点。"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#667085" />
                </Border>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="2"
                Background="#FFFFFF"
                BorderBrush="#D8DEE8"
                BorderThickness="1,0,0,0"
                Padding="16">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding PropertyPanelTitle}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#243044"
                           Margin="0,0,0,12" />
                <TextBlock Text="选中节点后会显示可编辑配置。"
                           TextWrapping="Wrap"
                           Foreground="#667085" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
