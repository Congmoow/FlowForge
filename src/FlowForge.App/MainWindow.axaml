<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:FlowForge.App.Controls"
        xmlns:vm="using:FlowForge.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="760"
        x:Class="FlowForge.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding ApplicationName}"
        Width="1200"
        Height="760"
        MinWidth="960"
        MinHeight="600">
    <Grid ColumnDefinitions="240,*,300"
          RowDefinitions="Auto,*"
          Background="#F6F7F9">
        <Border Grid.ColumnSpan="3"
                Background="#FFFFFF"
                BorderBrush="#D8DEE8"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <TextBlock Text="{Binding ApplicationName}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#172033"
                           VerticalAlignment="Center" />
                <Menu Grid.Column="1"
                      Margin="16,0,0,0"
                      Background="Transparent">
                    <MenuItem Header="文件">
                        <MenuItem Header="新建" Command="{Binding NewCommand}" HotKey="Ctrl+N" />
                        <MenuItem Header="打开…" Command="{Binding OpenCommand}" HotKey="Ctrl+O" />
                        <Separator />
                        <MenuItem Header="保存" Command="{Binding SaveCommand}" HotKey="Ctrl+S" />
                        <MenuItem Header="另存为…" Command="{Binding SaveAsCommand}" HotKey="Ctrl+Shift+S" />
                    </MenuItem>
                    <MenuItem Header="编辑">
                        <MenuItem Header="撤销" Command="{Binding UndoCommand}" HotKey="Ctrl+Z" />
                        <MenuItem Header="重做" Command="{Binding RedoCommand}" HotKey="Ctrl+Y" />
                        <MenuItem Header="重做" Command="{Binding RedoCommand}" HotKey="Ctrl+Shift+Z" />
                    </MenuItem>
                </Menu>
                <TextBlock Grid.Column="2"
                           Text="{Binding StatusMessage}"
                           Foreground="#667085"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
                <Button Grid.Column="3"
                        Content="运行"
                        Command="{Binding RunCommand}"
                        Margin="10,0,0,0"
                        Padding="16,6" />
                <Button Grid.Column="4"
                        Content="停止"
                        Command="{Binding StopCommand}"
                        Margin="10,0,0,0"
                        Padding="16,6" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                Background="#FFFFFF"
                BorderBrush="#D8DEE8"
                BorderThickness="0,0,1,0"
                Padding="16">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding ToolboxTitle}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#243044"
                           Margin="0,0,0,12" />
                <controls:ToolboxListBox ItemsSource="{Binding Toolbox.Templates}"
                                         SelectedItem="{Binding Toolbox.SelectedTemplate}"
                                         Background="Transparent"
                                         BorderThickness="0">
                    <controls:ToolboxListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NodeTemplateViewModel">
                            <Border Background="#F8FAFC"
                                    BorderBrush="#D8DEE8"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,8"
                                    Padding="10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               Foreground="#243044" />
                                    <TextBlock Text="{Binding TypeId}"
                                               FontSize="11"
                                               Foreground="#667085"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </controls:ToolboxListBox.ItemTemplate>
                </controls:ToolboxListBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="18"
                Background="#FFFFFF"
                BorderBrush="#D8DEE8"
                BorderThickness="1"
                Padding="18">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding CanvasTitle}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#243044"
                           Margin="0,0,0,12" />
                <controls:NodeCanvas MinHeight="360"
                                     x:Name="PerfCanvas"
                                     Canvas="{Binding Canvas}"
                                     Toolbox="{Binding Toolbox}" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="2"
                Background="#FFFFFF"
                BorderBrush="#D8DEE8"
                BorderThickness="1,0,0,0"
                Padding="16">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding PropertyPanelTitle}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#243044"
                           Margin="0,0,0,12" />
                <TextBlock Text="选中节点后会显示可编辑配置。"
                           TextWrapping="Wrap"
                           Foreground="#667085" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
